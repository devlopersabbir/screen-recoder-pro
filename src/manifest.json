{
  "manifest_version": 3,
  "name": "Screen Recorder Pro",
  "description": "Simple, private, local-first screen recorder. Record your entire screen, window, or tab offline with zero uploads or watermarks.",
  "version_name": "0.0.1",
  "icons": {
    "16": "icons/icon16.png",
    "19": "icons/icon19.png",
    "32": "icons/icon32.png",
    "38": "icons/icon38.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "19": "icons/icon19.png",
      "32": "icons/icon32.png",
      "38": "icons/icon38.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Screen Recorder Pro"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "web_accessible_resources": [
    {
      "resources": ["v1.png", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
